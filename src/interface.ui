<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <!-- Especificamos que usamos GTK 4 -->
  <requires lib="gtk" version="4.0"/>
  
  <!-- La ventana principal. Le ponemos un "id" para encontrarla desde C -->
  <object class="GtkApplicationWindow" id="main_window">
    <property name="title">Agregador con XML</property>
    <property name="default-width">300</property>
    <property name="default-height">400</property>
    
    <child>
      <!-- La caja principal -->
      <object class="GtkBox" id="main_box">
        <property name="orientation">vertical</property>
        <property name="spacing">10</property>
        <property name="margin-start">10</property>
        <property name="margin-end">10</property>
        <property name="margin-top">10</property>
        <property name="margin-bottom">10</property>
        
        <child>
          <!-- El botón para agregar -->
          <object class="GtkButton" id="add_button">
            <property name="label">➕ Agregar Elemento</property>
          </object>
        </child>
        
        <child>
          <!-- El área con scroll -->
          <object class="GtkScrolledWindow" id="scrolled_window">
            <property name="vexpand">true</property>
            <child>
              <!-- La caja interna donde meteremos los elementos dinámicos -->
              <object class="GtkBox" id="target_box">
                <property name="orientation">vertical</property>
                <property name="spacing">5</property>
              </object>
            </child>
          </object>
        </child>
        
      </object>
    </child>
  </object>
</interface>